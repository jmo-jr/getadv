<footer class="main-footer">
	<div class="container">
		<div class="d-flex flex-wrap justify-content-between align-items-center">
			<div class="copy">
				<p>{{ site.enderecos.matriz }}</p>
				<p>{{ site.enderecos.filial }}</p>
				<div class="d-flex flex-wrap align-items-center gap-xl change-mobile">
					<div class="left">
						<span class="phone-number">{{ site.telefone }}</span>
					</div>
					<div class="right">
						<span class="e-mail d-flex flex-wrap justify-content-center align-items-center" style="gap: 8px">
							<a href="mailto:" class="mail">{{ site.mail.carlos }}</a>
							<div class="divider"></div>
							<a href="mailto:" class="mail">{{ site.mail.alex }}</a>
						</span>
					</div>
				</div>
			</div>

			<div class="footer-logo">
				<img src="{{'/img/logo_br.svg' | url}}" alt="Guimarães e Teixeira Advogados" width="180">
			</div>
		</div>
		
	</div>
</footer>